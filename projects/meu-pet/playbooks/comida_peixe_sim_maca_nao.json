{
  "scenario": "outro pet, com o gosto oposto: adora o peixe e recusa a maçã",
  "tags": ["interacao", "pet", "individuo", "comida"],
  "steps": [
    { "type": "wait", "ms": 500 },
    { "type": "click", "entity": "botaoPetisco" },
    { "type": "wait", "ms": 100 },
    { "type": "click", "x": 425, "y": 349 },
    { "type": "wait", "ms": 2500 },
    {
      "type": "assert",
      "check": { "assert": "state", "id": "pet", "is": "happy" },
      "name": "adora peixe: fica feliz"
    },
    { "type": "assert", "check": { "assert": "variable", "var": "fome", "gt": 50 }, "name": "comeu peixe" },
    { "type": "wait", "ms": 2000 },
    { "type": "click", "entity": "botaoPetisco" },
    { "type": "wait", "ms": 100 },
    { "type": "click", "x": 315, "y": 349 },
    { "type": "wait", "ms": 1300 },
    {
      "type": "assert",
      "check": { "assert": "state", "id": "pet", "is": "walk" },
      "name": "recusa maca: se afasta"
    }
  ],
  "assertions": [
    {
      "assert": "eventOccurred",
      "event": "item_used",
      "match": { "item": "peixe", "target": "pet" },
      "name": "ofereceu peixe"
    },
    {
      "assert": "eventOccurred",
      "event": "reacao",
      "match": { "item": "peixe", "level": "love" },
      "name": "reação de amor a peixe"
    },
    {
      "assert": "eventOccurred",
      "event": "reacao",
      "match": { "item": "maca", "level": "hate" },
      "name": "reação de ódio a maca"
    },
    {
      "assert": "eventOccurred",
      "event": "observacao",
      "match": { "kind": "comida:maca" },
      "name": "observação da recusa"
    },
    { "assert": "variable", "var": "fome", "lt": 70, "name": "não comeu maca" },
    { "name": "peixe saiu do inventário", "expr": "itemCount('peixe') == 1" },
    { "name": "maca recusado continua no inventário", "expr": "itemCount('maca') == 2" }
  ],
  "screenshot": true,
