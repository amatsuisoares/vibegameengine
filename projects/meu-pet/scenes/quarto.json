        "Collider": { "width": 130, "height": 130, "offsetY": 15, "isTrigger": true },
        "Script": { "src": "scripts/pet.js" },
        "Interactable": { "action": "carinho", "via": ["click"] },
        "StateMachine": {
          "initial": "idle",
          "states": {
            "idle": {},
            "walk": {},
            "yawn": {},
            "sleep": {},
            "eat": {},
            "lookBowl": {},
            "play": {},
            "chase": {},
