      "transform": { "x": 480, "y": 425 },
      "components": {
        "Sprite": { "asset": "bebe_1", "width": 250, "height": 250, "layer": 5, "faceVelocity": false },
        "Collider": { "width": 130, "height": 130, "offsetY": 15, "isTrigger": true },
        "Script": { "src": "scripts/pet.js" },
        "Interactable": { "action": "carinho", "via": ["click"] },
        "StateMachine": {
          "initial": "idle",
          "states": {
            "idle": {},
            "walk": {},
            "yawn": {},
            "sleep": {},
            "eat": {},
            "lookBowl": {},
            "play": {},
            "chase": {},
            "toy": {},
            "investigate": {},
            "greet": {},
            "sulk": {},
            "happy": {},
            "evolve": {}
          }
        },
        "UtilityAI": {
          "select": "weighted",
          "intervalMs": 0,
          "options": {
            "passear": { "score": "1 + trait('atividade') * 2 + trait('curiosidade')" },
            "parado": { "score": "0.6 + (1 - trait('atividade')) * 3 + self.props.doente * 6" },
            "investigar": { "score": "0.2 + trait('curiosidade') * 3" },
            "cumprimentar": {
              "score": "0.2 + trait('sociabilidade') * 2.5 * (1.2 - trait('independencia')) + (self.props.afeto < 40) * 2 * trait('sociabilidade')"
            },
            "brincar": {
              "score": "0.3 + trait('brincadeira') * 2.5 + max(0, likes('bola')) * 1.5 + (self.props.diversao < 40) * 1.5",
              "when": "self.props.temBola && self.props.energia > 30"
            },
            "emburrar": {
              "score": "1.5 * (1 - trait('paciencia'))",
              "when": "trait('paciencia') < 0.35 && self.props.diversao < 50"
            }
          }
        },
        "Animator": {
          "initial": "idle",
          "auto": false,
          "animations": { "idle": { "frames": ["bebe_1", "bebe_2"], "fps": 2 } }
        },
        "Traits": {
          "generate": {
            "atividade": { "min": 0.05, "max": 0.95 },
            "sociabilidade": { "min": 0.05, "max": 0.95 },
            "curiosidade": { "min": 0.05, "max": 0.95 },
            "independencia": { "min": 0.05, "max": 0.95 },
