            "evolve": {},
            "nap": {},
            "dance": {}
          }
        },
        "UtilityAI": {
          "select": "weighted",
          "intervalMs": 0,
          "options": {
            "passear": { "score": "0.4 + trait('atividade') * 1.5 + habit('passear') * 0.5" },
            "brincar": {
              "score": "(0.3 + trait('brincadeira') * 2) * (0.4 + clamp((85 - self.props.diversao) / 70, 0, 1) * 1.6) * target.props.peso + habit('brincar') * 0.8",
              "when": "self.props.energia > 35 - trait('brincadeira') * 25 && !self.props.doente",
              "targets": { "tag": "brinquedo", "when": "target.props.peso > 0" }
            },
            "emburrar": {
              "score": "1.5 * (1 - trait('paciencia'))",
              "when": "trait('paciencia') < 0.35 && self.props.diversao < 50"
            },
            "dormir": {
              "when": "self.props.energia < 50 || self.props.noite",
              "score": "(clamp((50 - self.props.energia) / 30, 0, 1) * 7 + self.props.noite * (self.props.energia < self.props.limiteSono) * 8) * (1.6 - trait('atividade') * 1.2) + habit('dormir')"
            },
            "comer": {
              "when": "self.props.temRacao || !self.props.olhouTigela",
              "score": "clamp((self.props.limiteFome + 15 - self.props.fome) / 40, 0, 1) * 7 * (0.4 + trait('apetite') * 1.2) + habit('comer') * 0.5"
            },
            "explorar": {
              "targets": { "tag": "pontoCurioso" },
              "cooldownMs": 8000,
              "score": "0.2 + trait('curiosidade') * 2 - distance(self, target) / 2000 + habit('explorar') * 0.5"
            },
            "procurar": {
              "score": "trait('sociabilidade') * (0.3 + clamp((75 - self.props.afeto) / 60, 0, 1) * 2.5) * (1.2 - trait('independencia')) + (self.props.fome < 30 && !self.props.temRacao) * trait('sociabilidade') * 2 + habit('procurar') * 0.8 + memory('voce', 'carinho') * trait('sociabilidade') * 1.5 + memory('voce', 'acordado') * 2"
            },
            "descansar": {
              "score": "0.5 + (1 - trait('atividade')) * 1.5 + clamp((60 - self.props.energia) / 60, 0, 1) * 1.5 + self.props.doente * 4 + habit('descansar') * 0.5"
            },
            "chamar": {
              "when": "self.props.temBola && self.props.energia > 30 && !self.props.doente",
              "cooldownMs": 60000,
              "score": "memory('voce', 'brincouComVoce') * 3 * (0.3 + clamp((90 - self.props.diversao) / 50, 0, 1)) * (0.5 + trait('sociabilidade'))"
            },
            "cochilar": {
              "targets": { "tag": "lugarDeDormir" },
              "when": "self.props.energia < 80 && !self.props.noite && !self.props.doente",
              "cooldownMs": 90000,
              "score": "(1.3 - trait('atividade')) * clamp((90 - self.props.energia) / 40, 0, 1.2) * (0.4 + env('comfort', target)) * (1 - env('noise', target) * trait('sensibilidade')) + habit('cochilar') * 0.5"
            },
            "dancar": {
              "targets": { "tag": "musica", "when": "target.props.tocando" },
              "when": "self.props.energia > 25 && !self.props.doente",
              "cooldownMs": 30000,
              "score": "(likes('caixinhaMusica') - 0.1) * 3 * (0.6 + trait('atividade'))"
            },
            "afastar": { "when": "self.props.musicaIncomoda", "cooldownMs": 20000, "score": 3 }
          },
          "noise": 1,
          "inertia": 0,
          "sharpness": 2
        },
        "Animator": {
          "initial": "idle",
          "auto": false,
          "animations": { "idle": { "frames": ["bebe_1", "bebe_2"], "fps": 2 } }
