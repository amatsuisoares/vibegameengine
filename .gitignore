node_modules/
dist/
coverage/
*.log
.env
.env.*
# runtime artifacts produced by agent runs (screenshots, run logs)
projects/*/.vibe/runs/
# change history written by the ProjectStore (local undo log)
projects/*/.vibe/history.jsonl
# temporary copy made by the e2e tests
projects/e2e-tmp/
# published agent run mirrored by the runtime page (follow mode)
projects/*/.vibe/live.json
# saved data of played games (game.storage)
projects/*/.vibe/save.json
# screenshots written by the e2e tests
test-results/
# entity selected in the hierarchy panel (editor state)
projects/*/.vibe/selection.json
